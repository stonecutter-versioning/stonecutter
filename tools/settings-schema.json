{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeberg.org/stonecutter/stonecutter/src/branch/0.7/tools/settings-schema.json",
  "title": "Stonecutter Versions",
  "description": "Defines version set used by Stonecutter",
  "type": "object",
  "definitions": {
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_\\-+.]*$"
    },
    "file": {
      "type": "string",
      "pattern": "[A-Za-z_][A-Za-z0-9_\\-+.]*(\\.gradle)(\\.kts)?"
    },
    "branch": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_][A-Za-z0-9_\\-+.]*)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[_a-zA-Z][_\\-a-zA-Z0-9]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)*(?:-[A-Za-z0-9_\\-+.]+(?:\\.[A-Za-z0-9_\\-+.]+)*)?(?:\\+[A-Za-z0-9_\\-+.]+(?:\\.[A-Za-z0-9_\\-+.]+)*)?$"
    },
    "primitive_project": {
      "type": "string",
      "pattern": "^([_a-zA-Z][_\\-a-zA-Z0-9]*)(:(([_a-zA-Z][_\\-a-zA-Z0-9]*)|(\\d+(?:\\.\\d+)*(?:-[A-Za-z0-9_\\-+.]+(?:\\.[A-Za-z0-9_\\-+.]+)*)?(?:\\+[A-Za-z0-9_\\-+.]+(?:\\.[A-Za-z0-9_\\-+.]+)*)?))?)?(:([A-Za-z_][A-Za-z0-9_\\-+.]*(\\.gradle)(\\.kts)?))?$"
    },
    "composite_project": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/definitions/project"
        },
        "version": {
          "oneOf": [
            {"$ref": "#/definitions/identifier"},
            {"$ref": "#/definitions/semver"}
          ]
        },
        "buildscript": {
          "$ref": "#/definitions/file"
        }
      },
      "required": ["project"]
    },
    "project_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          { "$ref": "#/definitions/primitive_project" },
          { "$ref": "#/definitions/composite_project" }
        ]
      }
    },
    "branch_entry": {
      "oneOf": [
        {
          "$ref": "#/definitions/project_array"
        },
        {
          "type": "object",
          "properties": {
            "versions": {
              "$ref": "#/definitions/project_array"
            }
          },
          "required": ["versions"]
        }
      ]
    },
    "branch_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/branch"
      }
    },
    "version_entry": {
      "oneOf": [
        {
          "$ref": "#/definitions/branch_array"
        },
        {
          "type": "object",
          "properties": {
            "branches": {
              "$ref": "#/definitions/branch_array"
            }
          },
          "required": ["branches"]
        }
      ]
    }
  },
  "properties": {
    "vcs": {
      "$ref": "#/definitions/identifier",
      "description": "Name of the project used as Version Control reset point."
    },
    "kotlin_buildscript": {
      "type": "boolean"
    },
    "branches": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/branch_entry"
      },
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/branch"
      }
    },
    "versions": {
      "oneOf": [
        {
          "$ref": "#/definitions/project_array"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/version_entry"
          },
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/primitive_project"
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "branches"
      ]
    },
    {
      "required": [
        "versions"
      ]
    }
  ]
}